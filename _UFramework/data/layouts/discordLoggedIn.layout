FrameWidgetClass rootFrame {
 visible 1
 clipchildren 0
 ignorepointer 1
 position 8 8
 size 286 36
 halign right_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  ImageWidgetClass avatar {
   ignorepointer 1
   size 32 32
   halign right_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   imageTexture "{4521A210490C6BA5}_UFramework/images/discord.edds"
   mode blend
   "src alpha" 1
   "stretch mode" fit_h_center
  }
  TextWidgetClass username {
   inheritalpha 1
   ignorepointer 1
   position 36 0
   size 200 0.98
   halign right_ref
   valign center_ref
   hexactpos 1
   vexactpos 0
   hexactsize 1
   vexactsize 0
   text "CTRL + L to Link Discord"
   font "gui/fonts/metron-bolditalic"
   "exact text" 1
   "size to text h" 1
   "size to text v" 0
   "text halign" right
   "text valign" center
  }
 }
}