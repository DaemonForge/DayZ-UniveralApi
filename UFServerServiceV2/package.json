{
  "name": "ufserverservice",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon app.js",
    "build": "electron-builder",
    "pkg": "pkg . --compress GZip && node build.js",
    "tunnel": "cloudflared tunnel --config .cloudflared/config.yaml run ufdev"
  },
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemonforge/DayZ-UniveralApi.git"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "ajv": "^8.17.1",
    "crypto": "^1.0.1",
    "discord.js": "^14.18.0",
    "ejs": "^3.1.10",
    "ejs-lint": "^2.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "gamedig": "^5.2.0",
    "greenlock-express": "^4.0.3",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.14.0",
    "node-windows": "^1.0.0-beta.8",
    "openai": "^4.86.2",
    "serve-favicon": "^2.5.0",
    "vm": "^0.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9"
  },
  "pkg": {
  "assets": [
    "node_modules/ffmpeg-static/ffmpeg.exe"
  ]
  },
  "build": {
    "appId": "com.daemonforge.ufserverservice",
    "productName": "Universal Framework Service",
    "directories": {
      "output": "../Build/UFService"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/universalFrameworklogo.ico"
    },
    "extraFiles": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "public/license.txt",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "removeDefaultUninstallWelcomePage": true,
      "include": "installer.nsi"
    }
  },
  "bugs": {
    "url": "https://github.com/daemonforge/DayZ-UniveralApi/issues"
  },
  "homepage": "https://github.com/daemonforge/DayZ-UniveralApi#readme",
  "description": ""
}
