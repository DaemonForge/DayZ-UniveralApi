{
  "name": "ufserverservice",
  "version": "2.0.0",
  "description": "Universal Framework Service - Backend service for DayZ modding with Discord, AI, and database integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon app.js",
    "build": "dotenv -e .env.trustedsigning -- electron-builder",
    "build:unsigned": "electron-builder -c.win.azureSignOptions=null",
    "pkg": "pkg . --compress GZip --target node22-win-x64 --output ../Build/Service/ufserverservice-win.exe && node build.js",
    "pkg:linux": "pkg . --compress GZip --target node22-linux-x64 --output ../Build/Service/ufserverservice-linux && node -e \"require('fs').copyFileSync('install-linux.sh', '../Build/Service/install.sh')\"",
    "pkg:all": "npm run pkg && npm run pkg:linux",
    "tunnel": "cloudflared tunnel --config .cloudflared/config.yaml run ufdev"
  },
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemonforge/DayZ-UniveralApi.git"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "ace-builds": "^1.32.9",
    "ajv": "^8.17.1",
    "crypto": "^1.0.1",
    "discord.js": "^14.18.0",
    "ejs": "^3.1.10",
    "ejs-lint": "^2.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "gamedig": "^5.3.2",
    "greenlock-express": "^4.0.3",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.14.0",
    "node-fetch": "^3.3.2",
    "node-windows": "^1.0.0-beta.8",
    "openai": "^4.86.2",
    "serve-favicon": "^2.5.0",
    "vm": "^0.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.10.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.9"
  },
  "bin": "bin.js",
  "pkg": {
    "scripts": [
      "controllers/**/*.js",
      "models/**/*.js",
      "auth/**/*.js",
      "discord/**/*.js",
      "node_modules/gamedig/dist/**/*.cjs"
    ],
    "assets": [
      "package.json",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffmpeg-static/ffmpeg",
      "node_modules/gamedig/dist/**/*",
      "node_modules/gamedig/lib/**/*",
      "node_modules/gamedig/protocols/**/*",
      "public/**/*",
      "templates/**/*",
      "sample-config.json",
      "defaultkeys.json"
    ],
    "ignore": [
      "node_modules/electron/**/*",
      "node_modules/electron-builder/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ]
  },
  "build": {
    "appId": "com.daemonforge.ufserverservice",
    "productName": "UniversalFrameworkService",
    "icon": "public/icon256X256.png",
    "directories": {
      "output": "../Build/UFService"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "azureSignOptions": {
        "publisherName": "Kevin Hoddinott",
        "endpoint": "https://eus.codesigning.azure.net/",
        "certificateProfileName": "DaemonForge",
        "codeSigningAccountName": "DaemonForge"
      }
    },
    "extraFiles": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin/texconv.exe",
        "to": "texconv.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "public/license.txt",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "removeDefaultUninstallWelcomePage": true,
      "include": "installer.nsi",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "bugs": {
    "url": "https://github.com/daemonforge/DayZ-UniveralApi/issues"
  },
  "homepage": "https://github.com/daemonforge/DayZ-UniveralApi#readme"
}
